# Copy to .env and adjust. Never commit the real .env.
#
# Secrets: generate with `openssl rand -base64 48`. The API refuses to start
# with these placeholders when NODE_ENV=production.

# --- Core ---
NODE_ENV=development
API_PORT=3001
APP_URL="http://localhost:3000"

# --- Database ---
DATABASE_URL="postgresql://vintrax:vintrax@localhost:5432/vintrax_dev?schema=public"
POSTGRES_PASSWORD=vintrax

# --- Auth ---
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Redis, cache and queues ---
# Redis authenticates. `docker compose` reads REDIS_PASSWORD to set requirepass;
# REDIS_URL has to carry the same password, in the `redis://:PASSWORD@host` form
# (the empty username before the colon is deliberate — Redis has no user here).
REDIS_PASSWORD=vintrax
REDIS_URL="redis://:vintrax@127.0.0.1:6379"
# `redis` runs jobs through BullMQ; `inline` executes them in-process, which
# keeps development and CI working without a broker.
QUEUE_DRIVER=redis
CACHE_TTL_SECONDS=60

# --- Storage ---
# `local` writes to disk; `s3` targets any S3-compatible object store.
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ca-central-1"
S3_BUCKET="vintrax-media"
S3_ACCESS_KEY_ID="vintraxadmin"
S3_SECRET_ACCESS_KEY="vintraxadmin"
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL="https://cdn.example.com"

# --- Search ---
# `postgres` uses native full-text search and needs no extra infrastructure.
# `opensearch` delegates to a cluster and falls back to postgres if unreachable.
SEARCH_PROVIDER=postgres
OPENSEARCH_NODE="http://localhost:9200"
OPENSEARCH_INDEX="vintrax-vehicles"
# Only needed when the cluster has its security plugin enabled.
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# --- Email ---
# `log` prints messages to the server log, which is what development uses.
MAIL_DRIVER=log
MAIL_FROM="Vintrax <no-reply@vintrax.local>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# --- Web and mobile clients ---
# NEXT_PUBLIC_* values are compiled into the browser bundle, so changing one is
# a rebuild rather than a restart. Both clients read the same values; Next.js
# loads env files from each app's own directory, so setup-ubuntu.sh writes
# frontend/.env.local and mobile/.env.local from these.
MOBILE_PORT=3002
NEXT_PUBLIC_API_URL="/api"
# WebSockets cannot go through Next's rewrite proxy, so the socket connects
# to the API origin directly.
NEXT_PUBLIC_WS_URL="http://localhost:3001"
API_ORIGIN="http://127.0.0.1:3001"
