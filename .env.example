# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas_dev?schema=public"

# --- API ---
API_PORT=3000
NODE_ENV=development

# Secrets: generate with `openssl rand -base64 48`. These defaults are for local dev only
# and the API refuses to boot with them when NODE_ENV=production.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173"

# Where uploaded listing images are written in local development.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880

# --- Web ---
VITE_API_URL="http://localhost:3000/api"
