{
  "name": "@atlas/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Mobile — installable mobile-first client for the Atlas marketplace and auction platform",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p ${MOBILE_PORT:-3002}",
