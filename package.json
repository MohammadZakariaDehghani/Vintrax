{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Project Atlas - vehicle marketplace platform",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "shared:build": "pnpm --filter @atlas/shared build",
    "dev": "pnpm shared:build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm shared:build && pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm shared:build && pnpm -r test",
    "typecheck": "pnpm shared:build && pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @atlas/api prisma:migrate",
    "db:seed": "pnpm --filter @atlas/api prisma:seed",
    "db:reset": "pnpm --filter @atlas/api prisma:reset"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
