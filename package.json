{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas \u2014 enterprise digital automotive marketplace and auction platform",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "shared:build": "pnpm --filter @atlas/shared build",
    "dev": "pnpm shared:build && pnpm --parallel --filter \"@atlas/backend\" --filter \"@atlas/frontend\" dev",
    "dev:backend": "pnpm shared:build && pnpm --filter @atlas/backend dev",
    "dev:frontend": "pnpm shared:build && pnpm --filter @atlas/frontend dev",
    "dev:mobile": "pnpm shared:build && pnpm --parallel --filter \"@atlas/backend\" --filter \"@atlas/mobile\" dev",
    "dev:all": "pnpm shared:build && pnpm --parallel --filter \"@atlas/backend\" --filter \"@atlas/frontend\" --filter \"@atlas/mobile\" dev",
    "build": "pnpm shared:build && pnpm --filter @atlas/backend build && pnpm --filter @atlas/frontend build && pnpm --filter @atlas/mobile build",
    "start": "pnpm --parallel --filter \"@atlas/backend\" --filter \"@atlas/frontend\" --filter \"@atlas/mobile\" start",
    "setup": "bash scripts/setup-ubuntu.sh",
    "lint": "pnpm shared:build && pnpm -r lint",
    "test": "pnpm shared:build && pnpm -r test",
    "test:e2e": "pnpm --filter @atlas/frontend test:e2e",
    "typecheck": "pnpm shared:build && pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @atlas/backend prisma:migrate",
    "db:migrate:dev": "pnpm --filter @atlas/backend prisma:migrate:dev",
    "db:seed": "pnpm --filter @atlas/backend prisma:seed",
    "db:reset": "pnpm --filter @atlas/backend prisma:reset",
    "db:studio": "pnpm --filter @atlas/backend prisma:studio",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down -v"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "fast-uri": "^3.1.6",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "js-yaml@5": "^5.2.2",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "@nestjs/core"
    ]
  }
}
