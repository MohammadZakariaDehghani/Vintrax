# Vintrax production environment.
#
# Copy to the server as /opt/vintrax/env/vintrax.env, fill in every value, then
#   chmod 600 /opt/vintrax/env/vintrax.env
#
# This file is read by `docker compose --env-file`. It holds real credentials in
# production and must never be committed. Nothing here reaches an image: the
# values are injected into containers at run time.
#
# Generate every secret with:  openssl rand -base64 48

# --- Which images to run ----------------------------------------------------
# Set by scripts/deploy.sh. Pin an exact tag, never `latest`, or a rollback has
# nothing to roll back to.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-owner
VINTRAX_VERSION=sha-0000000

# --- Public addresses -------------------------------------------------------
APP_URL=https://vintrax.example.com
# Comma-separated allowlist of browser origins permitted to call the API.
# The API sends credentials, so this cannot be a wildcard.
CORS_ORIGINS=https://vintrax.example.com,https://m.vintrax.example.com

# --- Database ---------------------------------------------------------------
# With COMPOSE_PROFILES=bundled the host is the compose service name `postgres`
# and the three POSTGRES_* values below provision it. With a managed database,
# point DATABASE_URL at it and leave the POSTGRES_* values unset.
DATABASE_URL=postgresql://vintrax:CHANGE_ME@postgres:5432/vintrax?schema=public
POSTGRES_USER=vintrax
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vintrax

# --- Redis ------------------------------------------------------------------
# The empty username before the colon is deliberate: Redis has no user here.
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME

# --- Auth -------------------------------------------------------------------
# Must differ from each other, and must not be the .env.example placeholders —
# the API refuses to start in production with either.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENTLY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Storage ----------------------------------------------------------------
# `local` writes to the uploads-data volume; `s3` targets an object store and
# then S3_BUCKET and S3_ACCESS_KEY_ID are required.
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760
# S3_ENDPOINT=
# S3_REGION=ca-central-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=true

# --- Search, queues, cache --------------------------------------------------
SEARCH_PROVIDER=postgres
# OPENSEARCH_NODE=
OPENSEARCH_INDEX=vintrax-vehicles
# Only needed when the cluster has its security plugin enabled.
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
QUEUE_DRIVER=redis
CACHE_TTL_SECONDS=60

# --- Email ------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_FROM=Vintrax <no-reply@vintrax.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# --- Host binding -----------------------------------------------------------
# All three bind to 127.0.0.1 only; Nginx is what the internet reaches.
API_BIND_PORT=3001
WEB_BIND_PORT=3000
MOBILE_BIND_PORT=3002

# --- Run PostgreSQL and Redis in this stack too -----------------------------
# Comment out when using managed services.
COMPOSE_PROFILES=bundled

# --- Build-time values, for reference only ----------------------------------
# These are NOT read here. Next compiles them into the browser bundle, so they
# are build arguments in the GitHub Actions workflow and changing one means
# rebuilding the image, not restarting the container:
#
#   NEXT_PUBLIC_API_URL   /api
#   NEXT_PUBLIC_WS_URL    https://vintrax.example.com   (WebSockets cannot go
#                         through Next's rewrite proxy, so the socket addresses
#                         the API origin directly)
#   API_ORIGIN            http://api:3001               (rewrite destination;
#                         unused behind Nginx, which routes /api itself)
