// Vintrax marketplace schema.
//
// The enums here mirror packages/shared/src/domain.ts exactly. If you change one,
// change the other and generate a migration — the API validates input against the
// shared constants before Prisma ever sees it.
//
// Money is stored as an integer number of whole Canadian dollars throughout.
// Floating-point money accumulates rounding error; see D-010 in the decision log.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  BUYER
  SELLER
  DEALER
  INSPECTOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DealerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  IN_AUCTION
  SOLD
  ARCHIVED
}

enum InventoryImportStatus {
  VALIDATED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum SaleChannel {
  FIXED_PRICE
  AUCTION
  ACCEPTING_OFFERS
}

enum VehicleCondition {
  NEW
  USED
  CERTIFIED_PRE_OWNED
  SALVAGE
}

enum BodyType {
  SEDAN
  SUV
  TRUCK
  COUPE
  HATCHBACK
  MINIVAN
  WAGON
  CONVERTIBLE
  VAN
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  DUAL_CLUTCH
  /// A single-speed EV reduction gear, or anything else that is none of the above.
  OTHER
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  HYDROGEN
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WHEEL_DRIVE
  /// None of the above. Dealership feeds use this value explicitly.
  OTHER
}

enum VehicleDocumentType {
  REGISTRATION
  TITLE
  CARFAX
  SERVICE_RECORD
  SAFETY_CERTIFICATE
  BILL_OF_SALE
  OTHER
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConditionGrade {
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
}

enum InspectionSection {
  EXTERIOR
  INTERIOR
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  ELECTRICAL
  TIRES
  FRAME
  ROAD_TEST
}

enum SectionRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  NOT_APPLICABLE
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  SETTLED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  WON
  LOST
  RETRACTED
}

enum NotificationType {
  BID_PLACED
  OUTBID
  AUCTION_WON
  AUCTION_LOST
  AUCTION_STARTING
  AUCTION_ENDING
  LISTING_APPROVED
  LISTING_REJECTED
  INSPECTION_COMPLETED
  MESSAGE_RECEIVED
  DEALER_VERIFIED
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum AddressType {
  BILLING
  SHIPPING
  BUSINESS
  PICKUP
}

enum Province {
  AB
  BC
  MB
  NB
  NL
  NS
  NT
  NU
  ON
  PE
  QC
  SK
  YT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(BUYER)
  status       UserStatus @default(PENDING)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phone     String?
  province  Province?
  city      String?
  avatarUrl String?

  /// Channels this user accepts notifications on.
  notificationChannels NotificationChannel[] @default([IN_APP, EMAIL])

  lastLoginAt DateTime?

  dealer Dealer?

  vehicles      Vehicle[]
  addresses     Address[]
  favourites    Favourite[]
  bids          Bid[]
  notifications Notification[]
  messages      Message[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  auditLogs     AuditLog[]

  bodyTypeImages BodyTypeImage[]
  articles       Article[]
  footerSections FooterSection[]
  siteSettings   SiteSettings[]
  homeFeatures   HomeFeature[]
  promoTiles     PromoTile[]
  makeLogos      MakeLogo[]
  partners       Partner[]

  vehicleImageAssets VehicleImageAsset[]

  vehicleCostsRecorded VehicleCost[] @relation("VehicleCostRecordedBy")

  financeApplicationsSent     FinanceApplication[]   @relation("FinanceApplicant")
  financeApplicationsReceived FinanceApplication[]   @relation("FinanceSeller")
  financeSettings             SellerFinanceSettings?

  supportChats        SupportChat[]        @relation("SupportChatAccount")
  supportChatMessages SupportChatMessage[] @relation("SupportChatAuthor")

  inventoryImports    InventoryImport[] @relation("InventoryImportSeller")
  inventoryImportsRun InventoryImport[] @relation("InventoryImportInitiator")

  inspectionsPerformed VehicleInspection[] @relation("InspectorInspections")

  // A conversation has exactly one buyer and one seller, so the User relation
  // is disambiguated by name rather than a join table.
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")

  wonAuctions Auction[] @relation("AuctionWinner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
  @@index([status, createdAt])
}

/// Present only for DEALER accounts. Verification is an admin action.
model Dealer {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @unique @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name String
  slug String @unique

  status   DealerStatus @default(PENDING)
  verified Boolean      @default(false)

  businessNumber String?
  licenceNumber  String?
  description    String? @db.Text
  websiteUrl     String?
  phone          String?
  logoUrl        String?

  city     String?
  province Province?

  verifiedAt       DateTime?
  verificationNote String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([verified, province])
}

model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       AddressType
  line1      String
  line2      String?
  city       String
  province   Province
  postalCode String
  country    String      @default("CA")
  isDefault  Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

/// Refresh tokens are stored hashed so a database leak cannot be replayed.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use tokens for email verification and password reset, stored hashed.
model AuthToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       TokenType
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

/// When a listed vehicle can be handed over.
enum VehicleAvailability {
  IMMEDIATELY
  WITHIN_A_WEEK
  WITHIN_A_MONTH
  ON_ORDER
}

model Vehicle {
  id       String @id @default(uuid()) @db.Uuid
  /// Stable, human-readable URL segment. Unique so it can be routed on directly.
  slug     String @unique
  sellerId String @db.Uuid
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text

  /// Not unique: the same vehicle can legitimately be relisted after a sale.
  vin         String?
  /// The seller's own stock number. Unique within a seller's inventory, not
  /// globally — two dealerships both numbering a car "A1042" is normal, and a
  /// global constraint would make one of them unable to list it.
  stockNumber String?
  make        String
  model       String
  trim        String?
  year        Int

  priceCad         Int
  /// The asking price before the most recent change, shown struck through
  /// above the current one. Null until the price is first changed.
  previousPriceCad Int?
  /// Lowest price the seller will accept. Never exposed to buyers.
  reservePriceCad  Int?
  mileageKm        Int

  condition    VehicleCondition
  bodyType     BodyType
  transmission Transmission
  fuelType     FuelType
  drivetrain   Drivetrain

  engine             String?
  engineSizeL        Float?
  cylinders          Int?
  doors              Int?
  seats              Int?
  horsepower         Int?
  exteriorColour     String?
  /// The maker's own paint name, e.g. "Satin Silver Metallic".
  manufacturerColour String?
  interiorColour     String?
  curbWeightLbs      Int?

  /// Whether the vehicle is damaged. Null: the seller has not said, which is
  /// not the same as "no" and is never shown as if it were.
  isDamaged        Boolean?
  ownerCount       Int?
  availability     VehicleAvailability?
  /// An additional warranty the dealer offers, included in the price.
  extendedWarranty Boolean?
  /// A YouTube link. The listing frames YouTube's no-cookie player built from
  /// the video id, never this address itself.
  videoUrl         String?

  /// Reference prices the dealer keeps with the vehicle. Never returned to
  /// anyone but the seller and administrators: the public price is `priceCad`.
  salePriceCad      Int?
  msrpCad           Int?
  invoicePriceCad   Int?
  retailPriceCad    Int?
  wholesalePriceCad Int?

  province   Province
  city       String
  postalCode String?

  /// The brand on the vehicle's title. Nullable, because every listing created
  /// before this field existed has no stated brand and defaulting them to CLEAN
  /// would assert something about cars nobody checked.
  titleStatus TitleStatus?

  /// The seller's link to this vehicle's CARFAX report. Validated against the
  /// real CARFAX hosts before it is stored — the badge it sits behind carries a
  /// third party's name, so it must not be able to point anywhere else. Purely
  /// an associated reference now (issue #67, superseding D-047): nothing reads
  /// or scrapes this page, so the fields below are never derived from it.
  carfaxUrl String?

  /// Five badges the dealer sets directly, each independent of the others and
  /// of `carfaxUrl` itself — the one source of truth every badge-drawing
  /// surface in the app reads (see `toVehicleBadges` in vehicles.mapper.ts).
  /// All default false rather than being nullable tri-states: there is no
  /// extraction job whose "has not run yet" a null needs to distinguish from
  /// "checked and false" any more, so plain booleans are what these are.
  badgeLowKilometres Boolean @default(false)
  badgeOneOwner      Boolean @default(false)
  badgeNoAccident    Boolean @default(false)
  badgeCarfax        Boolean @default(false)

  status      ListingStatus @default(DRAFT)
  saleChannel SaleChannel   @default(FIXED_PRICE)
  /// How the vehicle entered the seller's inventory. Set once, on create, and
  /// never by the client: the form writes MANUAL and the CSV importer writes
  /// CSV_IMPORT. The dealer inventory filters on it.
  source      VehicleSource @default(MANUAL)

  features String[] @default([])

  viewCount      Int @default(0)
  favouriteCount Int @default(0)

  publishedAt    DateTime?
  soldAt         DateTime?
  moderatedAt    DateTime?
  moderationNote String?   @db.Text

  images              VehicleImage[]
  documents           VehicleDocument[]
  historyEvents       VehicleHistoryEvent[]
  favourites          Favourite[]
  conversations       Conversation[]
  auctions            Auction[]
  inspections         VehicleInspection[]
  /// What the dealer paid to acquire and prepare this vehicle. Private to the
  /// seller: never selected by any public or buyer-facing query.
  costs               VehicleCost[]
  financeApplications FinanceApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The CSV importer matches a row to an existing vehicle by VIN and then by
  // stock number, always within one seller. These two back that lookup, and the
  // unique constraint is what stops an import creating a second row for a stock
  // number the seller already uses. NULLs do not collide in Postgres, so the
  // many vehicles with no stock number are unaffected.
  @@unique([sellerId, stockNumber])
  // Search almost always constrains status first, so it leads the composite
  // indexes backing the common browse-and-sort paths.
  @@index([status, publishedAt])
  @@index([status, priceCad])
  @@index([status, make, model])
  @@index([status, province])
  @@index([status, saleChannel])
  @@index([sellerId, status])
  @@index([vin])
  @@index([sellerId, vin])
  // The dealer inventory's default order, and its source filter.
  @@index([sellerId, updatedAt])
  @@index([sellerId, source])
}

enum VehicleSource {
  MANUAL
  CSV_IMPORT
}

enum VehicleCostCategory {
  PURCHASE
  AUCTION_FEE
  TRANSPORTATION
  INSPECTION
  MECHANICAL_REPAIR
  BODY_REPAIR
  DETAILING
  PARTS
  TIRES
  CERTIFICATION
  LICENSING
  OTHER
}

/// One cost a dealer incurred on a vehicle: what they paid for it, or what it
/// took to get it ready to sell. A vehicle has any number of these.
///
/// Ownership is the vehicle's, and deliberately not repeated here: every read
/// and write filters through `vehicle.sellerId`, so a cost can never belong to
/// a different dealer than the car it is recorded against.
model VehicleCost {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  category    VehicleCostCategory
  description String?
  /// In cents, so $450.75 is exact. Vehicle prices are whole dollars; repair
  /// invoices are not.
  amountCents Int
  /// The date on the invoice, not when it was typed in.
  incurredOn  DateTime            @db.Date
  vendor      String?
  reference   String?
  notes       String?             @db.Text

  /// Who recorded it. Kept if that account is later removed.
  recordedById String? @db.Uuid
  recordedBy   User?   @relation("VehicleCostRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, incurredOn])
  @@index([vehicleId, category])
  @@index([createdAt])
}

/// One run of the dealer CSV importer. Written on confirm, never on preview.
model InventoryImport {
  id       String @id @default(uuid()) @db.Uuid
  /// The seller whose inventory was changed. Ownership lives on Vehicle.sellerId,
  /// so this is the same user, and it is what scopes the history listing.
  sellerId String @db.Uuid
  seller   User   @relation("InventoryImportSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  /// Who ran it. Normally the seller; an admin acting on their behalf differs.
  initiatedById String? @db.Uuid
  initiatedBy   User?   @relation("InventoryImportInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  filename      String
  schemaVersion Int
  /// SHA-256 of the uploaded bytes, so a re-run of the same file is recognisable.
  fileHash      String
  status        InventoryImportStatus

  totalRows      Int @default(0)
  createdCount   Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  errorCount     Int @default(0)

  /// Per-row outcomes, as returned to the client. Capped by MAX_INVENTORY_CSV_ROWS.
  rows Json?

  /// Photo download progress. The vehicles are written and returned before any
  /// photo is fetched — a rooftop's feed is a four-figure number of downloads
  /// from someone else's server — so these advance after the import itself has
  /// already completed, and are what the history screen reads to say so.
  photoStatus    InventoryPhotoStatus @default(NOT_REQUESTED)
  photosExpected Int                  @default(0)
  photosFetched  Int                  @default(0)
  photosReused   Int                  @default(0)
  photosFailed   Int                  @default(0)
  /// Why photos failed, deduplicated. Never the whole list: one unreachable
  /// host produces the same line 1200 times and none of them is new.
  photoErrors    String[]             @default([])

  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  photosFinishedAt  DateTime?
  /// Written while a photo run is alive. The run lives in the API process, so a
  /// restart ends it without a word; a PENDING or RUNNING import whose heartbeat
  /// has gone quiet is marked FAILED rather than shown as working forever.
  photosHeartbeatAt DateTime?

  @@index([sellerId, createdAt])
  @@index([photoStatus])
}

enum InventoryPhotoStatus {
  /// The file carried no photo columns, or the dealer chose to skip them.
  NOT_REQUESTED
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model VehicleImage {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  alt      String?
  /// Zero-based display order; position 0 is the primary image.
  position Int     @default(0)

  /// The third-party address this photo was downloaded from, when it came from
  /// a dealer feed. Null for a photo the dealer uploaded here, which is what
  /// tells the importer which rows it owns and may replace.
  sourceUrl       String?
  /// The feed's own last-modified stamp for `sourceUrl`. Together the two are
  /// the identity of an imported photo: unchanged means no second download.
  sourceUpdatedAt DateTime?

  /// The processed photo behind `url`: its dimensions and responsive
  /// variants. Null for a photo from before the image pipeline that
  /// `images:migrate` has not reached yet (or cannot: the SVG placeholders),
  /// which the frontend draws from `url` alone.
  assetId String?            @db.Uuid
  asset   VehicleImageAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([vehicleId, position])
  @@index([assetId])
  @@index([vehicleId, sourceUrl])
}

model VehicleDocument {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type      VehicleDocumentType
  url       String
  filename  String
  sizeBytes Int?

  /// The date printed on the document, as distinct from when it was uploaded.
  /// A history report dated eight months ago says something different about a
  /// vehicle than one pulled this morning, and only the dealer knows which it
  /// is. Nullable, because most paperwork has no meaningful date.
  issuedOn DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([vehicleId, type])
}

/// One entry on a vehicle's history timeline.
///
/// Entered by the seller from the history report they hold, not retrieved from
/// CARFAX by Vintrax — there is no integration, and the UI says so rather than
/// implying this was verified here. The uploaded report is the evidence and
/// lives in VehicleDocument; this is the summary a buyer can read without
/// requesting the PDF. Every entry is dealer-authored (issue #67, superseding
/// D-047's brief CARFAX-sourced variant): there is no second source to keep
/// apart from it any more, so unlike D-047's version this has no `source`
/// field to distinguish one.
model VehicleHistoryEvent {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  kind VehicleHistoryEventKind

  /// When it happened. Null for an entry with no date, which still sorts by
  /// `position` alongside the rest.
  occurredOn DateTime? @db.Date

  /// What happened, e.g. "Sold new" or "Service".
  label  String
  /// The supporting line, e.g. "Toronto, ON" or "16,000 km".
  detail String?

  /// Display order, so a seller can arrange entries that share a date.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([vehicleId, position])
}

enum TitleStatus {
  CLEAN
  REBUILT
  SALVAGE
}

enum VehicleHistoryEventKind {
  REGISTERED
  SOLD
  SERVICE
  ACCIDENT_DAMAGE
  CLAIM
  NO_ACCIDENTS
  NO_CLAIMS
  INSPECTION
  SAFETY_CERTIFIED
  RECALL
  OTHER
}

model VehicleInspection {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  inspectorId String @db.Uuid
  inspector   User   @relation("InspectorInspections", fields: [inspectorId], references: [id], onDelete: Restrict)

  status       InspectionStatus @default(SCHEDULED)
  overallGrade ConditionGrade?

  summary                    String?  @db.Text
  odometerReadingKm          Int?
  hasFrameDamage             Boolean?
  hasAccidentHistory         Boolean?
  estimatedReconditioningCad Int?

  sections InspectionSectionResult[]
  images   InspectionImage[]

  scheduledFor DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, status])
  @@index([inspectorId, status])
}

model InspectionSectionResult {
  id           String            @id @default(uuid()) @db.Uuid
  inspectionId String            @db.Uuid
  inspection   VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  section InspectionSection
  rating  SectionRating
  notes   String?           @db.Text

  /// One result row per section per inspection.
  @@unique([inspectionId, section])
}

model InspectionImage {
  id           String            @id @default(uuid()) @db.Uuid
  inspectionId String            @db.Uuid
  inspection   VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  url      String
  alt      String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@index([inspectionId, position])
}

model Favourite {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Auctions
// ---------------------------------------------------------------------------

model Auction {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  title  String
  status AuctionStatus @default(DRAFT)

  startingBidCad  Int
  /// Denormalised highest bid, kept in step with Bid rows inside a transaction
  /// so reads never have to aggregate.
  currentBidCad   Int  @default(0)
  bidCount        Int  @default(0)
  reservePriceCad Int?
  buyNowPriceCad  Int?

  startsAt      DateTime
  endsAt        DateTime
  /// Set when an anti-snipe extension moves the close time.
  extendedCount Int      @default(0)

  winnerId     String? @db.Uuid
  winner       User?   @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  winningBidId String? @unique @db.Uuid

  settledAt DateTime?

  bids Bid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([vehicleId])
  @@index([winnerId])
}

model Bid {
  id        String  @id @default(uuid()) @db.Uuid
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  bidderId String @db.Uuid
  bidder   User   @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  amountCad         Int
  /// Ceiling for proxy bidding. The engine raises to the minimum needed, up to
  /// this amount, rather than committing the full value immediately.
  maxProxyAmountCad Int?

  status BidStatus @default(ACTIVE)

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([auctionId, amountCad])
  @@index([auctionId, createdAt])
  @@index([bidderId, createdAt])
}

// ---------------------------------------------------------------------------
// Messaging and notifications
// ---------------------------------------------------------------------------

/// One thread per buyer per vehicle — a buyer messaging the same vehicle twice
/// continues the existing conversation rather than starting a new one.
model Conversation {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  buyerId String @db.Uuid
  buyer   User   @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String @db.Uuid
  seller   User   @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  /// Denormalised so inbox listings can sort without aggregating messages.
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @db.Uuid
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body   String    @db.Text
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String           @db.Text
  /// Deep link into the app, e.g. /auctions/<id>.
  link  String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of security- and money-relevant actions. Rows are never
/// updated or deleted; actorId is nullable so a deleted account does not erase
/// the history of what it did.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId    String? @db.Uuid
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?

  action     String
  entityType String
  entityId   String? @db.Uuid

  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// The photograph shown for a body type on the home page's browse row.
///
/// One row per body type at most — the body type is the primary key, so
/// setting an image is an upsert and there is no way to end up with two
/// pictures competing for the same tile. A body type with no row here falls
/// back to a photo from live inventory, and then to a drawn silhouette.
model BodyTypeImage {
  bodyType BodyType @id

  imageUrl String
  /// Alt text. Optional: these are decorative next to a visible label, and a
  /// redundant alt is worse for a screen reader than an empty one.
  alt      String?

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A blog post, or a standalone page such as "About us". Pages share the
/// editor and the body rules but never appear on the blog, the home page
/// banner or its carousel; they are reached by their own address,
/// `/pages/<slug>`, usually from a footer link.
enum ArticleKind {
  POST
  PAGE
}

/// An editorial post — the car writing that fronts the home page.
///
/// The newest published row becomes the masthead: hero photograph, headline,
/// standfirst and a call to action pointing back into inventory. The rest of
/// the body is read on the post's own page.
model Article {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique

  title    String
  /// The standfirst — one line under the headline on the masthead.
  subtitle String?
  /// Plain text. Blank lines separate paragraphs; nothing is interpreted as
  /// markup, so an author cannot put script or an iframe on the home page.
  body     String

  /// Required for a post, which fronts the home page; optional for a page.
  heroImageUrl String?
  heroAlt      String?

  /// Where the masthead button goes. An Vintrax path, never another origin —
  /// the front page should send traffic into the catalogue, not out of it.
  ctaLabel String?
  ctaHref  String?

  kind        ArticleKind   @default(POST)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status, publishedAt])
}

/// A social or contact link in the "Stay in touch" footer section. Purely
/// decorative — the icon chosen does not validate that `href` actually points
/// at that network, the same trust an operator already has over every other
/// field here.
enum FooterLinkIcon {
  FACEBOOK
  INSTAGRAM
  TWITTER
  YOUTUBE
  LINKEDIN
  EMAIL
  PHONE
  TIKTOK
  APPLE
  ANDROID
}

/// One column of the site footer — "About us", "Resources", "Partners",
/// "Stay in touch" by default, but the titles themselves are operator text,
/// not an enum, so a fifth section is just another row.
model FooterSection {
  id       String @id @default(uuid()) @db.Uuid
  title    String
  position Int
  /// Which of the footer's four columns the section sits in, 1–4. Two
  /// sections may share a column and stack, in `position` order.
  column   Int    @default(1)

  links FooterLink[]

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// One link under a footer section. `href` accepts a site path, an `https://`
/// address, a `mailto:` or a `tel:` — validated by the shared schema before
/// this is ever written, never here.
model FooterLink {
  id        String        @id @default(uuid()) @db.Uuid
  sectionId String        @db.Uuid
  section   FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  label    String
  href     String
  icon     FooterLinkIcon?
  /// An uploaded image drawn instead of the built-in icon — an issued upload
  /// URL, checked by the service, never an address on another server.
  imageUrl String?

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, position])
}

/// Site-wide settings an administrator edits: the footer's copyright lines
/// and everything the Contact page shows. One row, id 1, created by the
/// migration that introduced it.
model SiteSettings {
  id Int @id @default(1)

  footerCopyright String  @default("")
  footerNote      String?

  contactIntro       String?
  contactAddress     String?
  contactPhone       String?
  contactEmail       String?
  contactHours       String?
  /// An uploaded map or location image. Without one, the Contact page embeds
  /// a map of `contactAddress`.
  contactMapImageUrl String?
  /// A Google Maps link to the place. When set, the Contact page shows it as a
  /// live map ahead of `contactMapImageUrl`.
  contactMapUrl      String?
  /// Where Contact-form messages are emailed. Falls back to `contactEmail`.
  contactRecipient   String?

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

/// A message sent through the Contact page. Kept as well as emailed, so a
/// mail outage or an unconfigured SMTP server loses nothing.
model ContactMessage {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  email   String
  phone   String?
  subject String
  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The logo an administrator sets for a vehicle make, overriding the
/// generated mark the "popular makes" row on the home page otherwise draws.
///
/// Keyed on the make lowercased rather than an enum: unlike `BodyType`,
/// `Vehicle.make` is free text a dealer types, so there is no fixed set to key
/// on, and matching a make to its logo must not care whether someone typed
/// "Toyota" or "TOYOTA". Only makes an administrator has actually set a logo
/// for have a row here — there is no fallback row to backfill the way every
/// `BodyType` gets one, because a make with no row simply keeps drawing its
/// generated mark.
model MakeLogo {
  make String @id

  imageUrl String
  /// Alt text. Optional: the make's own name is printed right beside the mark
  /// on every card that draws it, so a redundant alt is worse for a screen
  /// reader than an empty one.
  alt      String?

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A logo shown in the homepage's "Our Partners" carousel (issue #67).
///
/// Unlike `MakeLogo`/`BodyTypeImage`, which decorate something that exists in
/// its own right (a make in stock, a body type), a partner exists only as
/// this row — there is no other record to key it on, so it gets its own id
/// rather than a natural key. `enabled` is what "only active partner logos
/// on the homepage" is built on: disabling one keeps the record (and its
/// logo) for an admin to re-enable later, rather than deleting and re-adding
/// it, and the public read filters on it directly.
model Partner {
  id   String @id @default(uuid()) @db.Uuid
  name String

  logoUrl String
  /// Optional: a partner's own name is printed beside its mark on the
  /// carousel, so a redundant alt is worse for a screen reader than none.
  alt     String?

  enabled Boolean @default(true)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, createdAt])
}

/// Where a home feature block's button sits: under the text (left, centred
/// or right), or over the photograph.
enum HomeFeatureButtonPlacement {
  TEXT_LEFT
  TEXT_CENTER
  TEXT_RIGHT
  ON_IMAGE
}

/// A feature block on the home page, under "Recently listed": a photograph,
/// a title, a few lines of text and an optional button to a page on Vintrax
/// or another website. Any number of them, stacked one under another in
/// `position` order — not a slideshow, and separate from the blog, so none
/// appears on the blog, the banner or the Research & advice menu.
model HomeFeature {
  id    String  @id @default(uuid()) @db.Uuid
  title String
  body  String? @db.Text

  /// An issued upload URL, checked by the service.
  imageUrl String?
  imageAlt String?

  buttonLabel     String?
  /// A site path or an `https://` address, validated by the shared schema.
  buttonUrl       String?
  buttonPlacement HomeFeatureButtonPlacement @default(TEXT_LEFT)

  position Int
  enabled  Boolean @default(true)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, position])
}

/// One of the three promo tiles on the home page, under the last-search card:
/// a photograph linking to a page on Vintrax or another website. Slots are
/// numbered 1 to 3 and saved whole; a slot without a row, or without an image,
/// is not shown.
enum PromoTileMediaType {
  IMAGE
  VIDEO
}

model PromoTile {
  id   String @id @default(uuid()) @db.Uuid
  slot Int    @unique

  /// An issued upload URL, checked by the service.
  imageUrl String?
  imageAlt String?
  /// A site path or an `https://` address, validated by the shared schema.
  linkUrl  String?

  /// Twelfths of the row.
  widthSpan Int     @default(4)
  /// Height on a full-width desktop page; the tile keeps its shape as it scales.
  heightPx  Int     @default(220)
  enabled   Boolean @default(true)

  /// What fills the tile. Width, height, slot and scaling above apply to
  /// either; switching keeps the other medium's fields, so it can be switched back.
  mediaType      PromoTileMediaType @default(IMAGE)
  /// The optimised, silent MP4, issued by the video upload route.
  videoUrl       String?
  /// A frame of that video, shown before it plays and when it cannot.
  videoPosterUrl String?

  updatedById String? @db.Uuid
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ImageProcessingStatus {
  PROCESSING
  READY
  FAILED
}

/// One uploaded vehicle photo after the image pipeline (issue #74): the
/// retained original plus the WebP (and optionally AVIF) variants the site
/// actually serves.
///
/// Separate from `VehicleImage` rather than columns on it because the two
/// have different lifetimes. A photo is uploaded, and processed, before its
/// listing exists — the add-vehicle form uploads first and saves later — and
/// `VehicleImage` rows are replaced wholesale every time a listing's photo
/// set is saved. What was produced from the file has to outlive both, keyed
/// by the file itself.
model VehicleImageAsset {
  id String @id @default(uuid()) @db.Uuid

  status ImageProcessingStatus @default(PROCESSING)
  /// Why processing failed, for the logs and the admin; never shown publicly.
  error  String?

  /// What a single-`src` consumer shows: the variant nearest
  /// IMAGE_FALLBACK_WIDTH. Also the value clients send back in a vehicle's
  /// `images[].url`, which is how a saved listing finds its asset.
  url     String   @unique
  /// Public URL the variants sit under: `<baseUrl>/<width>.<format>`.
  baseUrl String
  /// Rendered widths, ascending. Never above the original's own width.
  widths  Int[]
  /// Encoded formats, best-compressing first: `{avif,webp}` or `{webp}`.
  formats String[]
  /// Dimensions of the largest variant — the photo's display aspect ratio.
  width   Int?
  height  Int?

  /// Storage key of the untouched upload, kept for reprocessing. Stored
  /// outside the publicly served folders: it still carries the camera's
  /// EXIF, GPS position included.
  originalKey         String?
  originalContentType String?
  originalWidth       Int?
  originalHeight      Int?
  originalSizeBytes   Int?

  /// For a photo `images:migrate` produced from a pre-pipeline upload: the
  /// URL it was generated from. Unique so a second run finds it instead of
  /// processing the same file again.
  legacyUrl String? @unique

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  processingMs Int?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  images VehicleImage[]

  @@index([uploadedById])
}

// --- Finance applications -----------------------------------------------------
// A buyer's request that a seller arrange financing for one vehicle. Vintrax is
// not a lender and runs no credit check: the seller takes it to their own
// lenders. The applicant's personal and financial details are readable only by
// the seller (see backend/src/modules/finance).

enum FinanceApplicationStatus {
  NEW
  CONTACTED
  IN_REVIEW
  APPROVED
  DECLINED
  CLOSED
}

enum CreditRange {
  REBUILDING
  FAIR
  GOOD
  EXCELLENT
}

enum IncomeFrequency {
  ANNUALLY
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
  STUDENT
  NOT_EMPLOYED
  OTHER
}

enum HousingStatus {
  OWN
  RENT
  WITH_FAMILY
  OTHER
}

enum PreferredContact {
  PHONE
  EMAIL
  TEXT
}

model FinanceApplication {
  id String @id @default(uuid()) @db.Uuid

  vehicleId   String  @db.Uuid
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// The vehicle's seller when the application was sent; every read is scoped to it.
  sellerId    String  @db.Uuid
  seller      User    @relation("FinanceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  applicantId String  @db.Uuid
  applicant   User    @relation("FinanceApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  status FinanceApplicationStatus @default(NEW)

  firstName       String
  lastName        String
  email           String
  phone           String
  /// `YYYY-MM-DD`, as entered.
  dateOfBirth     String
  postalCode      String
  creditRange     CreditRange
  grossIncomeCad  Int
  incomeFrequency IncomeFrequency

  employmentStatus  EmploymentStatus
  employerName      String?
  jobTitle          String?
  employmentMonths  Int?
  housingStatus     HousingStatus
  monthlyHousingCad Int?
  addressMonths     Int?

  hasTradeIn       Boolean @default(false)
  tradeInYear      Int?
  tradeInMake      String?
  tradeInModel     String?
  tradeInMileageKm Int?
  tradeInOwedCad   Int?

  downPaymentCad     Int
  termMonths         Int
  preferredContact   PreferredContact
  preferredVisitDate String?
  comments           String?          @db.Text

  /// The seller's private notes.
  dealerNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status, createdAt])
  @@index([sellerId, createdAt])
  @@index([applicantId, vehicleId])
}

/// A seller's finance preferences. No row means the defaults: applications
/// accepted, announced to the account's own email.
model SellerFinanceSettings {
  sellerId String @id @db.Uuid
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  acceptApplications Boolean @default(true)
  notificationEmail  String?

  updatedAt DateTime @updatedAt
}

// --- Site chat ----------------------------------------------------------------
// Visitors ask the Vintrax assistant from any public page; the team reads and
// answers under Admin → Support. A chat is reachable by its visitor only
// through a random token, of which only the hash is kept.

enum SupportChatStatus {
  OPEN
  CLOSED
}

enum SupportMessageRole {
  VISITOR
  ASSISTANT
  AGENT
}

model SupportChat {
  id        String @id @default(uuid()) @db.Uuid
  /// SHA-256 of the visitor's token.
  tokenHash String @unique

  /// The account the chat was started from, when the visitor was signed in.
  userId String? @db.Uuid
  user   User?   @relation("SupportChatAccount", fields: [userId], references: [id], onDelete: SetNull)

  visitorName  String?
  visitorEmail String?
  pagePath     String?

  status         SupportChatStatus @default(OPEN)
  humanRequested Boolean           @default(false)
  agentJoined    Boolean           @default(false)
  /// Visitor messages no team member has opened yet.
  unreadByTeam   Int               @default(0)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages SupportChatMessage[]

  @@index([status, lastMessageAt])
  @@index([humanRequested, lastMessageAt])
}

model SupportChatMessage {
  id     String      @id @default(uuid()) @db.Uuid
  chatId String      @db.Uuid
  chat   SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role     SupportMessageRole
  body     String             @db.Text
  authorId String?            @db.Uuid
  author   User?              @relation("SupportChatAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}
