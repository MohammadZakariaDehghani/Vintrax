/// CASL consent records: what kind, from where, when, until when.
model CrmConsent {
  id           String      @id @default(uuid()) @db.Uuid
  dealerId     String      @db.Uuid
  dealer       Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
