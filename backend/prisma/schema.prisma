model SupportTeam {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  /// Admin user ids on the team, assigned round-robin.
  memberIds String[]        @db.Uuid
  cursor    Int             @default(0)
  isActive  Boolean         @default(true)
  tickets   SupportTicket[]
}

/// Platform-wide support settings (one row, id = 1).
model SupportSettings {
  id                  Int      @id @default(1)
  /// Hours to first response, by priority.
  firstResponseHours  Json     @default("{\"URGENT\":1,\"HIGH\":4,\"MEDIUM\":24,\"LOW\":72}")
  /// Hours to resolution, by priority.
  resolutionHours     Json     @default("{\"URGENT\":8,\"HIGH\":24,\"MEDIUM\":72,\"LOW\":168}")
  /// Remind the requester after this many days waiting on them.
  waitingReminderDays Int      @default(3)
  /// Close resolved tickets after this many days without a reply.
  autoCloseDays       Int      @default(7)
  defaultTeamId       String?  @db.Uuid
  updatedAt           DateTime @updatedAt
}

model SupportTicket {
  id     String @id @default(uuid()) @db.Uuid
  number Int    @unique @default(autoincrement())

  requesterId    String? @db.Uuid
  requester      User?   @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterEmail String
  requesterName  String?
  dealerId       String? @db.Uuid
  dealer         Dealer? @relation(fields: [dealerId], references: [id], onDelete: SetNull)

  subject            String
  description        String           @db.Text
  categoryId         String?          @db.Uuid
  category           SupportCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority           CrmPriority      @default(MEDIUM)
  status             TicketStatus     @default(NEW)
  source             TicketSource     @default(ADMIN)
  assignedToId       String?          @db.Uuid
  assignedTo         User?            @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  teamId             String?          @db.Uuid
  team               SupportTeam?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  dueAt              DateTime?
  firstResponseDueAt DateTime?
  firstResponseAt    DateTime?
  lastPublicReplyAt  DateTime?
  /// Who wrote last in public: REQUESTER or ADMIN.
  lastPublicReplyBy  String?
  waitingSince       DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  reopenedCount      Int              @default(0)
  resolution         String?          @db.Text
  contactMessageId   String?          @unique @db.Uuid
  supportChatId      String?          @db.Uuid
  createdById        String?          @db.Uuid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  messages    SupportTicketMessage[]
  events      SupportTicketEvent[]
  tags        SupportTicketTag[]
