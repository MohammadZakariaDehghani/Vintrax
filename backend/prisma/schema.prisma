}

model CrmLeadImport {
  id             String   @id @default(uuid()) @db.Uuid
  dealerId       String   @db.Uuid
  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  fileName       String
  totalRows      Int
  createdCount   Int
  duplicateCount Int
  errorCount     Int
  errors         Json?
  mapping        Json?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([dealerId, createdAt])
}

/// Email templates, a dealer's or the support team's.
model CrmEmailTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  scope       CrmScope
  dealerId    String?      @db.Uuid
  dealer      Dealer?      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  key         String?
  name        String
  category    String
  purpose     EmailPurpose @default(TRANSACTIONAL)
  subject     String
  /// Sanitised HTML.
  bodyHtml    String       @db.Text
  bodyText    String       @db.Text
  isActive    Boolean      @default(true)
  version     Int          @default(1)
  /// The earlier versions, newest first: [{ version, subject, bodyHtml, bodyText, savedAt }].
  history     Json?
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  emails    CrmEmail[]
  campaigns CrmCampaign[]

  @@unique([scope, dealerId, key])
  @@index([scope, dealerId, category])
}

/// The email outbox and sent log. Every email the CRM sends is a row here
/// first; the dispatcher claims due rows, sends them once, and records the
/// provider's answer.
model CrmEmail {
  id       String         @id @default(uuid()) @db.Uuid
  scope    CrmScope
  dealerId String?        @db.Uuid
  dealer   Dealer?        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leadId   String?        @db.Uuid
  lead     CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ticketId String?        @db.Uuid
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  userId   String?        @db.Uuid

  toEmail  String
  toName   String?
  fromName String?
  replyTo  String?
  subject  String
  bodyHtml String       @db.Text
  bodyText String       @db.Text
  purpose  EmailPurpose

  templateId       String?           @db.Uuid
  template         CrmEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignId       String?           @db.Uuid
  campaign         CrmCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  enrollmentId     String?           @db.Uuid
  automationStepId String?

  status            CrmEmailStatus @default(QUEUED)
  scheduledAt       DateTime       @default(now())
  /// When the dispatcher may try again after a failure.
  nextAttemptAt     DateTime       @default(now())
  attempts          Int            @default(0)
  lastError         String?
  /// Claimed by a dispatcher run until this time.
  lockedUntil       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  repliedAt         DateTime?
  bouncedAt         DateTime?
  unsubscribedAt    DateTime?
  provider          String?
  providerMessageId String?
  /// One logical email, one row: a retried automation step cannot send twice.
  idempotencyKey    String         @unique
  /// Opaque token in tracking and unsubscribe links.
  trackingToken     String         @unique
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events CrmEmailEvent[]

  @@index([status, nextAttemptAt])
  @@index([dealerId, createdAt])
  @@index([dealerId, status, createdAt])
  @@index([leadId, createdAt])
  @@index([ticketId, createdAt])
  @@index([campaignId])
  @@index([providerMessageId])
}

model CrmEmailEvent {
  id        String         @id @default(uuid()) @db.Uuid
  emailId   String         @db.Uuid
  email     CrmEmail       @relation(fields: [emailId], references: [id], onDelete: Cascade)
  type      EmailEventType
  detail    String?
  createdAt DateTime       @default(now())

  @@index([emailId, createdAt])
  @@index([type, createdAt])
}

/// Addresses not to send to. dealerId set: that dealer's list (unsubscribes
/// from its marketing); dealerId null: platform-wide (bounces, invalid).
model CrmSuppression {
  id          String            @id @default(uuid()) @db.Uuid
  dealerId    String?           @db.Uuid
  dealer      Dealer?           @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  email       String
  reason      SuppressionReason
  source      String?
  note        String?
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now())

  @@unique([dealerId, email, reason])
  @@index([email])
