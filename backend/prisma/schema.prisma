  lead   CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String  @db.Uuid
  tag    CrmTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

/// The unified timeline: activities people log and events the system records.
model CrmActivity {
  id         String          @id @default(uuid()) @db.Uuid
  dealerId   String          @db.Uuid
  dealer     Dealer          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leadId     String          @db.Uuid
  lead       CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String?         @db.Uuid
  user       User?           @relation("CrmActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  type       CrmTimelineType
  isSystem   Boolean         @default(false)
  occurredAt DateTime        @default(now())
  title      String
  status     String?
  notes      String?         @db.Text
  outcome    String?
  nextAction String?
  vehicleId  String?         @db.Uuid
  saleId     String?         @db.Uuid
  emailId    String?         @db.Uuid
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([leadId, occurredAt])
  @@index([dealerId, type, occurredAt])
  @@index([dealerId, userId, occurredAt])
}

model CrmTask {
  id                String        @id @default(uuid()) @db.Uuid
  dealerId          String        @db.Uuid
  dealer            Dealer        @relation(fields: [dealerId], references: [id], onDelete: Cascade)
