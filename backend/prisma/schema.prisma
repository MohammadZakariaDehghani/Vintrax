}

/// Append-only (a trigger refuses UPDATE and DELETE).
model AccountingAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  dealerId   String   @db.Uuid
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  actorId    String?  @db.Uuid
  actorEmail String?
  action     String
  entityType String
  entityId   String?  @db.Uuid
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([dealerId, createdAt])
  @@index([dealerId, entityType, entityId])
}

// =============================================================================
// CRM (D-066): the Dealer CRM (leads, follow-up, email automation) and the
