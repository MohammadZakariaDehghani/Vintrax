/// A file kept with an accounting record (receipt, auction invoice, bank
/// statement…). Stored with the private document storage and only ever
/// streamed back through the accounting API, to the same dealer.
model AccountingAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  dealerId     String   @db.Uuid
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  entityType   String
  entityId     String   @db.Uuid
  fileName     String
  contentType  String
  sizeBytes    Int
  url          String
