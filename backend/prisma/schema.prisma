  priority          CrmPriority   @default(MEDIUM)
  status            CrmTaskStatus @default(OPEN)
  reminderAt        DateTime?
  reminderSentAt    DateTime?
  overdueNotifiedAt DateTime?
  recurrence        CrmRecurrence @default(NONE)
  completedAt       DateTime?
  createdById       String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([dealerId, status, dueAt])
  @@index([dealerId, assignedToId, status, dueAt])
  @@index([leadId])
}

model CrmAppointment {
  id              String            @id @default(uuid()) @db.Uuid
  dealerId        String            @db.Uuid
  dealer          Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  leadId          String            @db.Uuid
  lead            CrmLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
