  ticketId  String        @db.Uuid
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?       @db.Uuid
  type      String
  fromValue String?
  toValue   String?
  detail    String?
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model AdminTask {
  id             String         @id @default(uuid()) @db.Uuid
  type           AdminTaskType  @default(OTHER)
  title          String
  description    String?        @db.Text
  assignedToId   String?        @db.Uuid
  assignedTo     User?          @relation("AdminTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  ticketId       String?        @db.Uuid
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  dealerId       String?        @db.Uuid
  subjectUserId  String?        @db.Uuid
