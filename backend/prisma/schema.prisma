/// One per dealership: how its CRM behaves.
model CrmSettings {
  dealerId String @id @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  /// IANA zone the dealership works in; schedules and send windows use it.
  timezone              String  @default("America/Toronto")
  /// Automated emails go out only between these local hours.
  sendWindowStartHour   Int     @default(9)
  sendWindowEndHour     Int     @default(19)
  /// 0 = Sunday … 6 = Saturday.
  sendDays              Int[]   @default([1, 2, 3, 4, 5, 6])
  /// First-response target for new leads, in minutes.
  responseTargetMinutes Int     @default(5)
  hotThreshold          Int     @default(50)
  warmThreshold         Int     @default(20)
  noResponseDays        Int     @default(3)
  inactiveDays          Int     @default(30)
  /// MANUAL, ROUND_ROBIN or RULES (rules, then round-robin).
  assignmentMode        String  @default("ROUND_ROBIN")
  roundRobinCursor      Int     @default(0)
  /// Create a "first contact" task on assignment.
  createFollowUpTask    Boolean @default(true)

  senderName      String?
  replyToEmail    String?
  /// CASL sender identification: mailing address and contact for every CEM.
  businessAddress String?
  businessPhone   String?
  businessEmail   String?

  /// Treat an inquiry as implied consent to marketing (CASL: 6 months).
  impliedConsentFromInquiry  Boolean @default(true)
  /// Treat a purchase as implied consent to marketing (CASL: 2 years).
  impliedConsentFromPurchase Boolean @default(true)

  postSaleEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrmLeadStatus {
  id         String         @id @default(uuid()) @db.Uuid
  dealerId   String         @db.Uuid
  dealer     Dealer         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  key        String
  label      String
  kind       LeadStatusKind
  position   Int
  /// Shown as a pipeline column.
  inPipeline Boolean        @default(true)
  isActive   Boolean        @default(true)
  leads      CrmLead[]

  @@unique([dealerId, key])
  @@index([dealerId, position])
}

model CrmLeadSource {
  id               String    @id @default(uuid()) @db.Uuid
  dealerId         String    @db.Uuid
  dealer           Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  key              String
  label            String
  /// Monthly spend on the source, for cost per lead.
  monthlyCostCents Int?
  isActive         Boolean   @default(true)
  leads            CrmLead[]

  @@unique([dealerId, key])
}

/// Tags: a dealer's (dealerId set) or the support team's (dealerId null).
model CrmTag {
  id       String             @id @default(uuid()) @db.Uuid
  scope    CrmScope
  dealerId String?            @db.Uuid
  dealer   Dealer?            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name     String
  color    String?
  leads    CrmLeadTag[]
  tickets  SupportTicketTag[]

  @@unique([scope, dealerId, name])
}

model CrmLead {
  id       String @id @default(uuid()) @db.Uuid
  dealerId String @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  number   Int

  firstName        String
  lastName         String?
  email            String?
  /// Lower-cased, for matching and suppression.
  emailNormalized  String?
  phone            String?
  /// Digits only, for duplicate matching.
  phoneNormalized  String?
  preferredContact PreferredContact?
  address          String?
  city             String?
  province         Province?
  postalCode       String?

  sourceId String?        @db.Uuid
  source   CrmLeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  campaign String?

  vehicleId              String?   @db.Uuid
  vehicle                Vehicle?  @relation("CrmLeadVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  interestedVin          String?
  vehicleUrl             String?
  budgetCents            Int?
  financingInterest      Boolean   @default(false)
  tradeInInterest        Boolean   @default(false)
  tradeInVehicle         String?
  preferredAppointmentAt DateTime?
  notes                  String?   @db.Text

  score       Int             @default(0)
  temperature LeadTemperature @default(COLD)
  statusId    String          @db.Uuid
  status      CrmLeadStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  lostReason  String?

  assignedToId String?   @db.Uuid
  assignedTo   User?     @relation("CrmLeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  team         String?
  assignedAt   DateTime?

  /// The marketplace account the lead came from, when there is one.
  userId               String?   @db.Uuid
  user                 User?     @relation("CrmLeadAccount", fields: [userId], references: [id], onDelete: SetNull)
  /// The accounting customer once converted (the dealership's one customer record).
  customerId           String?   @db.Uuid
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId       String?   @db.Uuid
  financeApplicationId String?   @db.Uuid

  firstContactAt DateTime?
  lastContactAt  DateTime?
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?
  lastRepliedAt  DateTime?
  convertedAt    DateTime?
  wonAt          DateTime?
  lostAt         DateTime?

  /// A merged lead points at the one it was merged into and is hidden.
  mergedIntoId String?   @db.Uuid
  mergedInto   CrmLead?  @relation("CrmLeadMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   CrmLead[] @relation("CrmLeadMerge")

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags         CrmLeadTag[]
  activities   CrmActivity[]
  tasks        CrmTask[]
  appointments CrmAppointment[]
  emails       CrmEmail[]
  enrollments  CrmAutomationEnrollment[]
  scoreEvents  CrmLeadScoreEvent[]
  consents     CrmConsent[]

  @@unique([dealerId, number])
  @@index([dealerId, statusId, createdAt])
  @@index([dealerId, assignedToId, nextFollowUpAt])
  @@index([dealerId, emailNormalized])
  @@index([dealerId, phoneNormalized])
  @@index([dealerId, createdAt])
  @@index([dealerId, temperature])
  @@index([dealerId, vehicleId])
  @@index([dealerId, userId])
  @@index([dealerId, customerId])
  @@index([mergedIntoId])
}

model CrmLeadTag {
