  updatedAt          DateTime             @updatedAt

  @@unique([dealerId, number])
  @@index([dealerId, date])
  @@index([dealerId, vehicleId])
}

model RecurringExpense {
  id            String              @id @default(uuid()) @db.Uuid
  dealerId      String              @db.Uuid
  dealer        Dealer              @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  description   String
  vendorId      String?             @db.Uuid
  accountId     String              @db.Uuid
  account       AcctAccount         @relation("RecurringExpenseAccount", fields: [accountId], references: [id], onDelete: Restrict)
  amount        Decimal             @db.Decimal(15, 2)
  applyTax      Boolean             @default(true)
  method        PaymentMethod
  bankAccountId String              @db.Uuid
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  frequency     RecurrenceFrequency
  nextDate      DateTime            @db.Date
  endDate       DateTime?           @db.Date
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([dealerId, nextDate])
}

model BankAccount {
  id                 String          @id @default(uuid()) @db.Uuid
  dealerId           String          @db.Uuid
  dealer             Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  name               String
  bankName           String?
  type               BankAccountType
  currency           String          @default("CAD")
  /// Last four digits only. Never a full account or card number.
  accountNumberLast4 String?
  glAccountId        String          @unique @db.Uuid
  glAccount          AcctAccount     @relation("BankGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)
  openingBalance     Decimal         @default(0) @db.Decimal(15, 2)
  openingDate        DateTime        @db.Date
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  acquisitions      VehicleAcquisition[]
  sales             VehicleSale[]
  deposits          CustomerDeposit[]
  payments          Payment[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  transactions      BankTransaction[]
  reconciliations   BankReconciliation[]

  @@index([dealerId])
}

model BankTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  dealerId         String              @db.Uuid
  dealer           Dealer              @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  bankAccountId    String              @db.Uuid
  bankAccount      BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  kind             BankTransactionKind
  date             DateTime            @db.Date
  amount           Decimal             @db.Decimal(15, 2)
  /// The other side: an account, or the other bank account of a transfer.
  counterAccountId String?             @db.Uuid
  toBankAccountId  String?             @db.Uuid
  description      String
  reference        String?
  journalEntryId   String?             @db.Uuid
  status           DocumentStatus      @default(POSTED)
  createdById      String?             @db.Uuid
  createdAt        DateTime            @default(now())

  @@index([dealerId, bankAccountId, date])
}

model BankReconciliation {
  id                String               @id @default(uuid()) @db.Uuid
  dealerId          String               @db.Uuid
  dealer            Dealer               @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  bankAccountId     String               @db.Uuid
  bankAccount       BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  statementDate     DateTime             @db.Date
  beginningBalance  Decimal              @db.Decimal(15, 2)
  endingBalance     Decimal              @db.Decimal(15, 2)
  status            ReconciliationStatus @default(IN_PROGRESS)
  clearedBalance    Decimal              @default(0) @db.Decimal(15, 2)
  difference        Decimal              @default(0) @db.Decimal(15, 2)
  adjustmentEntryId String?              @db.Uuid
  adjustmentReason  String?
  completedAt       DateTime?
  completedById     String?              @db.Uuid
  createdById       String?              @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  clearedLines JournalLine[]

  @@index([dealerId, bankAccountId, statementDate])
}

model FloorPlanNote {
  id              String          @id @default(uuid()) @db.Uuid
  dealerId        String          @db.Uuid
  dealer          Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
