  lead         CrmLead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  email        String
  type         ConsentType
  source       String
  /// What the person agreed to, in the words they saw.
  evidence     String?     @db.Text
  grantedAt    DateTime    @default(now())
  expiresAt    DateTime?
  withdrawnAt  DateTime?
  recordedById String?     @db.Uuid
  createdAt    DateTime    @default(now())

  @@index([dealerId, email])
  @@index([leadId])
}

model CrmCampaign {
  id             String            @id @default(uuid()) @db.Uuid
  dealerId       String            @db.Uuid
  dealer         Dealer            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name           String
  type           CampaignType
  status         CampaignStatus    @default(DRAFT)
  templateId     String?           @db.Uuid
  template       CrmEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject        String?
  /// Audience filter: statuses, sources, tags, provinces, makes, price range, activity dates.
  audience       Json
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  costCents      Int?
  recipientCount Int               @default(0)
  skippedCount   Int               @default(0)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  emails CrmEmail[]

  @@index([dealerId, status, scheduledAt])
}

/// A follow-up sequence or a support workflow. Steps are a small graph held
/// as JSON (validated by the API): WAIT, CONDITION with yes/no branches, and
/// actions, each pointing at the next step.
model CrmAutomation {
  id                String   @id @default(uuid()) @db.Uuid
  scope             CrmScope
  dealerId          String?  @db.Uuid
  dealer            Dealer?  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  key               String?
  name              String
  description       String?
  trigger           String
  /// Conditions the trigger must meet to enrol, and trigger options (days).
  triggerConfig     Json?
  steps             Json
  /// Stop when any of these happens: REPLIED, WON, LOST, …
  stopConditions    String[]
  /// Only within the dealer's send window.
  respectSendWindow Boolean  @default(true)
  isActive          Boolean  @default(false)
  version           Int      @default(1)
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments CrmAutomationEnrollment[]

  @@unique([scope, dealerId, key])
  @@index([scope, dealerId, trigger, isActive])
}

/// One lead's (or ticket's) progress through an automation. The scheduler
/// resumes it at `nextRunAt`, so a sequence survives restarts and closed
/// browsers.
model CrmAutomationEnrollment {
  id            String           @id @default(uuid()) @db.Uuid
  automationId  String           @db.Uuid
  automation    CrmAutomation    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  dealerId      String?          @db.Uuid
  leadId        String?          @db.Uuid
  lead          CrmLead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ticketId      String?          @db.Uuid
  ticket        SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status        EnrollmentStatus @default(ACTIVE)
  currentStepId String?
  nextRunAt     DateTime?
  lockedUntil   DateTime?
  attempts      Int              @default(0)
  lastError     String?
  stopReason    String?
  /// Steps run so far: [{ stepId, type, at, result }].
  history       Json             @default("[]")
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?

  @@index([status, nextRunAt])
  @@index([automationId, status])
  @@index([leadId, status])
  @@index([ticketId, status])
}

model CrmNotificationPreference {
  userId String  @db.Uuid
  user   User    @relation("CrmNotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)
