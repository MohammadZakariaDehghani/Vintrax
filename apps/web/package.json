{
  "name": "@atlas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas marketplace web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
